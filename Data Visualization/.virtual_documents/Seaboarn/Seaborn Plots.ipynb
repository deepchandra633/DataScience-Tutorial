plt.ylabel("Y")


sns.barplot(x="total_bill",y="tip",data=tips)
plt.title("Bar Plot")
plt.xlabel("X")
plt.ylabel("Y")


sns.boxplot(x="total_bill",y="tip",data=tips)
plt.title("Box Plot")
plt.xlabel("X")
plt.ylabel("Y")


